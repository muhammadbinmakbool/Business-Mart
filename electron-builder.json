{
  "appId": "com.businessmart.app",
  "productName": "Business Mart",
  "directories": {
    "output": "dist"
  },
  "files": [
    "package.json",
    "next.config.mjs",
    "postcss.config.mjs",
    "tsconfig.json",
    "jsconfig.json",
    "electron/**/*",
    ".next/standalone/**/*",
    "public/**/*",
    "prisma/**/*",
    "resources/**/*"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Business Mart",
    "runAfterFinish": true
  },
  "asar": true,
  "asarUnpack": [
    "node_modules/@prisma/**/*",
    "node_modules/prisma/**/*",
    "node_modules/.prisma/**/*",
    "node_modules/bcryptjs/**/*",
    "node_modules/effect/**/*",
    "node_modules/c12/**/*",
    "node_modules/deepmerge-ts/**/*",
    "node_modules/empathic/**/*",
    "node_modules/confbox/**/*",
    "node_modules/defu/**/*",
    "node_modules/destr/**/*",
    "node_modules/dotenv/**/*",
    "node_modules/exsolve/**/*",
    "node_modules/jiti/**/*",
    "node_modules/mlly/**/*",
    "node_modules/ohash/**/*",
    "node_modules/pathe/**/*",
    "node_modules/perfect-debounce/**/*",
    "node_modules/pkg-types/**/*",
    "node_modules/rc9/**/*",
    "node_modules/chokidar/**/*",
    "prisma/**/*",
    ".next/standalone/**/*"
  ],
  "extraResources": [
    {
      "from": "resources/config.json",
      "to": "config.json"
    }
  ]
}
